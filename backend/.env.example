# Server
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=merchantmind

# JWT (use a long random string in production)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Email (optional — for future nodemailer integration)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=example@gmail.com
EMAIL_PASS=app_password

# File uploads
UPLOAD_PATH=uploads

# CORS — frontend origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Cron — low-stock purchase order job schedule
CRON_LOW_STOCK_PO=*/1 * * * *
